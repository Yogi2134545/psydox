# Psydox environment variables — copy to .env and fill in values.
# NEVER commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
# Base URL used for email verification and password reset links.
# Set this to your production URL on Railway/Heroku/etc.
PSYDOX_BASE_URL=http://localhost:8501

# ── SMTP (email) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to use console (dev) email mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1

# ── Google AI / Nano Banana ───────────────────────────────────────────────────
# Nano Banana backend credentials — never expose in frontend code.
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Ideogram ─────────────────────────────────────────────────────────────────
IDEOGRAM_API_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to 1 to skip email verification (instant account activation).
# Use when SMTP is not configured. Remove once SMTP is working.
SKIP_EMAIL_VERIFICATION=0

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_MODE=0
