# Psydox environment variables — copy to .env and fill in values.
# NEVER commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
# Base URL used for email verification and password reset links.
# Set this to your production URL on Railway/Heroku/etc.
PSYDOX_BASE_URL=https://psydox-production.up.railway.app

# ── Email — Resend (recommended, free 100/day) ────────────────────────────────
# 1. Sign up at resend.com (free)
# 2. Go to API Keys → Create API Key
# 3. Paste it here
# Free tier sends from onboarding@resend.dev to any address.
# For custom from-address, verify your domain in Resend dashboard + set RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=Psydox <onboarding@resend.dev>

# ── Email — SMTP (alternative to Resend) ─────────────────────────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, PORT=587, generate an App Password for SMTP_PASS.
# (Google Account → Security → 2-Step Verification → App Passwords)
# Leave blank if using Resend above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1

# ── Google AI / Nano Banana ───────────────────────────────────────────────────
# Nano Banana backend credentials — never expose in frontend code.
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Ideogram ─────────────────────────────────────────────────────────────────
IDEOGRAM_API_KEY=

# ── Razorpay — wallet top-ups ─────────────────────────────────────────────────
# 1. Sign up at razorpay.com (free for test mode)
# 2. Dashboard → Settings → API Keys → Generate key
# 3. Use test keys for development, live keys for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Billing — cost markup ─────────────────────────────────────────────────────
# Percentage markup applied on top of actual API cost.
# Example: if API charges ₹1.00 for an image, customer pays ₹1.20 at 20% markup.
COST_MARKUP_PERCENT=20

# USD to INR conversion rate for API cost calculation.
# Update periodically to reflect current exchange rates.
USD_TO_INR=83

# Minimum wallet balance (INR) required to use AI tools.
BILLING_MIN_BALANCE_INR=1

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_MODE=0
